  utilisateur_id          String                    @db.Uuid
  attribution_affiliation attribution_affiliation[]
  affiliation             affiliation               @relation(fields: [affiliation_id], references: [id], onUpdate: NoAction, map: "fk_lien_affiliation")
  utilisateur             utilisateur               @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_lien_utilisateur")

  @@index([affiliation_id], map: "idx_lien_affiliation_affiliation")
  @@index([utilisateur_id], map: "idx_lien_affiliation_utilisateur")
}


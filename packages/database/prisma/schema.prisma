  operateur     operateur
  statut        statut_demande @default(EN_ATTENTE)
  date_creation DateTime       @default(now()) @db.Timestamptz(6)
  commande_id   String         @db.Uuid
  commande      commande       @relation(fields: [commande_id], references: [id], onUpdate: NoAction, map: "fk_demande_paiement_commande")
  paiement      paiement[]

  @@index([commande_id], map: "idx_demande_paiement_commande")
  @@index([statut], map: "idx_demande_paiement_statut")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ecriture_journal {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                   type_ecriture
  sens                   sens_ecriture
  montant                Decimal            @db.Decimal(12, 2)
  reference              String             @db.VarChar(255)
  date_creation          DateTime           @default(now()) @db.Timestamptz(6)
  paiement_id            String?            @db.Uuid
  versement_id           String?            @db.Uuid
  remboursement_id       String?            @db.Uuid
  corrige_ecriture_id    String?            @db.Uuid
  ecriture_journal       ecriture_journal?  @relation("ecriture_journalToecriture_journal", fields: [corrige_ecriture_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ecriture_journal_correction")
  other_ecriture_journal ecriture_journal[] @relation("ecriture_journalToecriture_journal")
  paiement               paiement?          @relation(fields: [paiement_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ecriture_paiement")
  remboursement          remboursement?     @relation(fields: [remboursement_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ecriture_remboursement")
  versement              versement?         @relation(fields: [versement_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_ecriture_versement")

  @@index([corrige_ecriture_id], map: "idx_ecriture_journal_correction")
  @@index([paiement_id], map: "idx_ecriture_paiement")
  @@index([remboursement_id], map: "idx_ecriture_remboursement")
  @@index([versement_id], map: "idx_ecriture_versement")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model evenement_outbox {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String           @db.VarChar(100)
  payload          Json
  statut           statut_evenement @default(EN_ATTENTE)
  tentatives       Int              @default(0)
  date_creation    DateTime         @default(now()) @db.Timestamptz(6)
  date_publication DateTime?        @db.Timestamptz(6)
}

model favori {
  utilisateur_id String      @db.Uuid
  annonce_id     String      @db.Uuid
  date_ajout     DateTime    @default(now()) @db.Timestamptz(6)
  annonce        annonce     @relation(fields: [annonce_id], references: [id], onUpdate: NoAction, map: "fk_favori_annonce")
  utilisateur    utilisateur @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_favori_utilisateur")

  @@id([utilisateur_id, annonce_id], map: "pk_favori")
  @@index([annonce_id], map: "idx_favori_annonce")
}

model identite_externe {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  utilisateur_id      String           @db.Uuid
  fournisseur         fournisseur_auth
  identifiant_externe String           @db.VarChar(255)
  date_creation       DateTime         @default(now()) @db.Timestamptz(6)
  utilisateur         utilisateur      @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_identite_utilisateur")

  @@unique([fournisseur, identifiant_externe], map: "uq_identite_fournisseur")
  @@unique([utilisateur_id, fournisseur], map: "uq_identite_utilisateur_fournisseur")
}

model journal_audit {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action            String         @db.VarChar(255)
  objet_type        String         @db.VarChar(100)
  objet_id          String?        @db.Uuid
  motif             String?

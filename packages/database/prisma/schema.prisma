  administrateur_id String         @db.Uuid
  administrateur    administrateur @relation(fields: [administrateur_id], references: [utilisateur_id], onUpdate: NoAction)

  @@index([administrateur_id], map: "idx_journal_audit_administrateur")
}

model lien_affiliation {

model message {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contenu         String
  date_envoi      DateTime     @default(now()) @db.Timestamptz(6)
  date_lecture    DateTime?    @db.Timestamptz(6)
  conversation_id String       @db.Uuid
  utilisateur_id  String       @db.Uuid
  annonce_id      String?      @db.Uuid
  annonce         annonce?     @relation(fields: [annonce_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_message_annonce")
  conversation    conversation @relation(fields: [conversation_id], references: [id], onUpdate: NoAction, map: "fk_message_conversation")
  utilisateur     utilisateur  @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_message_utilisateur")

  @@index([annonce_id], map: "idx_message_annonce", where: raw("(annonce_id IS NOT NULL)"))
  @@index([conversation_id, date_envoi(sort: Desc)], map: "idx_message_conversation_date")
  @@index([utilisateur_id], map: "idx_message_utilisateur")
}

model notification {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           type_notification
  contenu        String
  lue            Boolean           @default(false)
  date_creation  DateTime          @default(now()) @db.Timestamptz(6)
  utilisateur_id String            @db.Uuid
  utilisateur    utilisateur       @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction)

  @@index([utilisateur_id], map: "idx_notification_utilisateur")
}


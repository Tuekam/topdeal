generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [pg_trgm]
}

model administrateur {
  utilisateur_id        String                  @id @db.Uuid
  role                  role_admin
  utilisateur           utilisateur             @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_administrateur_utilisateur")
  journal_audit         journal_audit[]
  litige                litige[]
  paiement              paiement[]
  remboursement         remboursement[]
  signalement           signalement[]
  verification_identite verification_identite[]
  versement             versement[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model affiliation {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  active            Boolean            @default(true)
  remuneration_fixe Decimal            @db.Decimal(12, 2)
  date_activation   DateTime?          @db.Timestamptz(6)
  date_modification DateTime?          @db.Timestamptz(6)
  annonce_id        String             @unique @db.Uuid
  annonce           annonce            @relation(fields: [annonce_id], references: [id], onUpdate: NoAction, map: "fk_affiliation_annonce")
  lien_affiliation  lien_affiliation[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model annonce {
  id                                                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titre                                               String          @db.VarChar(255)
  description                                         String?
  etat                                                etat_article
  prix                                                Decimal         @db.Decimal(12, 2)
  quantite                                            Int
  quartier                                            String?         @db.VarChar(150)
  troc_accepte                                        Boolean         @default(false)
  visibilite                                          visibilite
  disponibilite                                       disponibilite
  date_publication                                    DateTime?       @db.Timestamptz(6)
  utilisateur_id                                      String          @db.Uuid
  categorie_id                                        String          @db.Uuid
  categorie_souhaitee_id                              String?         @db.Uuid
  souhait_echange_description                         String?
  affiliation                                         affiliation?
  categorie_annonce_categorie_idTocategorie           categorie       @relation("annonce_categorie_idTocategorie", fields: [categorie_id], references: [id], onUpdate: NoAction, map: "fk_annonce_categorie")
  categorie_annonce_categorie_souhaitee_idTocategorie categorie?      @relation("annonce_categorie_souhaitee_idTocategorie", fields: [categorie_souhaitee_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_annonce_categorie_souhaitee")
  utilisateur                                         utilisateur     @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_annonce_utilisateur")
  commande                                            commande[]
  favori                                              favori[]
  message                                             message[]
  photo_annonce                                       photo_annonce[]
  proposition                                         proposition[]
  troc_troc_annonce_a_idToannonce                     troc[]          @relation("troc_annonce_a_idToannonce")
  troc_troc_annonce_b_idToannonce                     troc[]          @relation("troc_annonce_b_idToannonce")

  @@index([categorie_id], map: "idx_annonce_categorie")
  @@index([categorie_souhaitee_id], map: "idx_annonce_categorie_souhaitee")
  @@index([visibilite, disponibilite], map: "idx_annonce_recherche")
  @@index([visibilite, date_publication(sort: Desc), id(sort: Desc)], map: "idx_annonce_publication_cursor")
  @@index([utilisateur_id, date_publication(sort: Desc), id(sort: Desc)], map: "idx_annonce_proprietaire_cursor")
  @@index([titre(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_annonce_titre_trgm")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_annonce_description_trgm")
  @@index([quartier(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_annonce_quartier_trgm")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attribution_affiliation {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantite              Int
  prix_base_unitaire    Decimal             @db.Decimal(12, 2)
  remuneration_unitaire Decimal             @db.Decimal(12, 2)
  prix_final_unitaire   Decimal             @db.Decimal(12, 2)
  statut                statut_remuneration @default(EN_ATTENTE)
  commande_id           String              @unique @db.Uuid
  lien_affiliation_id   String              @db.Uuid
  versement_id          String?             @unique @db.Uuid
  commande              commande            @relation(fields: [commande_id], references: [id], onUpdate: NoAction, map: "fk_attribution_commande")
  lien_affiliation      lien_affiliation    @relation(fields: [lien_affiliation_id], references: [id], onUpdate: NoAction, map: "fk_attribution_lien")
  versement             versement?          @relation(fields: [versement_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_attribution_versement")

  @@index([lien_affiliation_id], map: "idx_attribution_lien")
}

model categorie {
  id                                                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom                                               String      @db.VarChar(150)
  active                                            Boolean     @default(true)
  parent_id                                         String?     @db.Uuid
  annonce_annonce_categorie_idTocategorie           annonce[]   @relation("annonce_categorie_idTocategorie")
  annonce_annonce_categorie_souhaitee_idTocategorie annonce[]   @relation("annonce_categorie_souhaitee_idTocategorie")
  categorie                                         categorie?  @relation("categorieTocategorie", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_categorie_parent")
  other_categorie                                   categorie[] @relation("categorieTocategorie")

  @@index([parent_id], map: "idx_categorie_parent")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model code_remise {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code_hash       String      @unique @db.VarChar(255)
  tentatives      Int         @default(0)
  statut          statut_code @default(ACTIF)
  date_generation DateTime    @default(now()) @db.Timestamptz(6)
  date_validation DateTime?   @db.Timestamptz(6)
  commande_id     String      @unique @db.Uuid
  commande        commande    @relation(fields: [commande_id], references: [id], onUpdate: NoAction, map: "fk_code_remise_commande")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commande {
  id                                            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference                                     String                   @unique @db.VarChar(100)
  type                                          type_commande
  quantite                                      Int
  prix_unitaire                                 Decimal                  @db.Decimal(12, 2)
  montant_total                                 Decimal                  @db.Decimal(12, 2)
  lieu_remise                                   String?                  @db.VarChar(255)
  heure_remise                                  DateTime?                @db.Timestamptz(6)
  statut                                        statut_commande          @default(CREEE)
  date_creation                                 DateTime                 @default(now()) @db.Timestamptz(6)
  acheteur_id                                   String                   @db.Uuid
  vendeur_id                                    String                   @db.Uuid
  annonce_id                                    String                   @db.Uuid
  attribution_affiliation                       attribution_affiliation?
  code_remise                                   code_remise?
  utilisateur_commande_acheteur_idToutilisateur utilisateur              @relation("commande_acheteur_idToutilisateur", fields: [acheteur_id], references: [id], onUpdate: NoAction, map: "fk_commande_acheteur")
  annonce                                       annonce                  @relation(fields: [annonce_id], references: [id], onUpdate: NoAction, map: "fk_commande_annonce")
  utilisateur_commande_vendeur_idToutilisateur  utilisateur              @relation("commande_vendeur_idToutilisateur", fields: [vendeur_id], references: [id], onUpdate: NoAction, map: "fk_commande_vendeur")
  demande_paiement                              demande_paiement[]
  litige                                        litige[]
  proposition                                   proposition?
  remboursement                                 remboursement[]
  ticket_support                                ticket_support[]
  troc                                          troc?
  versement                                     versement[]

  @@index([acheteur_id], map: "idx_commande_acheteur")
  @@index([annonce_id], map: "idx_commande_annonce")
  @@index([statut], map: "idx_commande_statut")
  @@index([vendeur_id], map: "idx_commande_vendeur")
}

model conversation {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statut                   statut_conversation        @default(ACTIVE)
  date_creation            DateTime                   @default(now()) @db.Timestamptz(6)
  derniere_activite        DateTime?                  @db.Timestamptz(6)
  message                  message[]
  participant_conversation participant_conversation[]
  proposition              proposition[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model demande_paiement {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
